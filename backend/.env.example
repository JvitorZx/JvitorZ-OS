# Backend environment variables
PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=your_jwt_secret
LOG_LEVEL=info

# Google Cloud credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Controlled local automation runtime (disabled by default)
AUTOMATION_RUNTIME_ENABLED=false
AUTOMATION_POLL_INTERVAL_MS=60000
AUTOMATION_MAX_RETRIES=0

# Strategic monitoring is controlled persistently from the Monitoring workspace.
# It remains disabled until explicitly activated. Periodic ticks use this shared runtime.
