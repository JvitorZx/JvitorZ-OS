generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      String?    @default("user")
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id               String             @id @default(cuid())
  name             String
  description      String?
  ownerId          String
  owner            User               @relation(fields: [ownerId], references: [id])
  conversations    Conversation[]
  libraryItems     LibraryItem[]
  automations      Automation[]
  analyticsSnapshots AnalyticsSnapshot[]
  videoIdeas         VideoIdea[]
  channelInsights    ChannelInsight[]
  performanceSignals PerformanceSignal[]
  videoPerformanceSnapshots VideoPerformanceSnapshot[]
  videoReachSnapshots VideoReachSnapshot[]
  audienceSnapshots   AudienceSnapshot[]
  trendSignals        TrendSignal[]
  seriesDefinitions   SeriesDefinition[]
  contentPatterns     ContentPattern[]
  editorialDecisions EditorialDecision[]
  orchestrationExecutions OrchestrationExecution[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Conversation {
  id               String                    @id @default(cuid())
  projectId        String?
  project          Project?                  @relation(fields: [projectId], references: [id])
  title            String?
  context          String?
  messages         Message[]
  libraryItemLinks ConversationLibraryItem[]
  editorialDecisions EditorialDecision[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         String
  text           String
  libraryItem    LibraryItem?
  editorialDecision EditorialDecision?
  createdAt      DateTime  @default(now())
}

model Operator {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String?   @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ChannelSnapshot {
  id              String   @id @default(cuid())
  channelId       String   @unique
  title           String
  subscriberCount String?
  videoCount      String?
  viewCount       String?
  country         String?
  publishedAt     DateTime?
  collectedAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([collectedAt])
}

model LibraryItem {
  id                String                    @id @default(cuid())
  projectId         String?
  project           Project?                  @relation(fields: [projectId], references: [id])
  sourceMessageId   String?                   @unique
  sourceMessage     Message?                  @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  conversationLinks ConversationLibraryItem[]
  title             String
  type              String?
  content           String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model ConversationLibraryItem {
  conversationId String
  libraryItemId  String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  libraryItem    LibraryItem  @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([conversationId, libraryItemId])
  @@index([conversationId, createdAt, libraryItemId])
  @@index([libraryItemId])
}

model Automation {
  id                 String                 @id @default(cuid())
  projectId          String?
  project            Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name               String
  description        String?
  trigger            String?
  action             String?
  triggerType        String                 @default("MANUAL_ONLY")
  schedule           Json?
  timezone           String                 @default("UTC")
  intent             String?
  orchestrationInput Json?
  status             String                 @default("DISABLED")
  riskLevel          String?
  sideEffectLevel    String?
  enabled            Boolean                @default(false)
  nextRunAt          DateTime?
  lastRunAt          DateTime?
  runs               AutomationRun[]
  auditEvents        AutomationAuditEvent[]
  governancePolicy   AutomationGovernancePolicy?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([enabled, status, nextRunAt])
  @@index([projectId, createdAt])
}

model AutomationRun {
  id                       String     @id @default(cuid())
  automationId             String
  automation               Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  occurrenceKey            String
  triggerSource            String
  status                   String     @default("PENDING")
  scheduledFor             DateTime?
  orchestrationExecutionId String?
  resultSummary            String?
  failureReason            String?
  attempt                  Int        @default(1)
  sourceRunId              String?
  startedAt                DateTime?
  completedAt              DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@unique([automationId, occurrenceKey])
  @@index([automationId, createdAt])
  @@index([status, createdAt])
  @@index([orchestrationExecutionId])
  @@index([sourceRunId])
}

model AutomationGovernancePolicy {
  automationId              String     @id
  automation                Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  enabled                   Boolean    @default(true)
  maxRunsPerDay             Int?
  maxRunsPerWeek            Int?
  cooldownMinutes           Int?
  allowedExecutionWindows   Json?
  maxConsecutiveFailures    Int?
  pauseOnRepeatedFailure    Boolean    @default(true)
  manualApprovalRequired    Boolean    @default(false)
  retryPolicy               Json?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  @@index([enabled, updatedAt])
}

model AutomationAuditEvent {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runId        String?
  eventType    String
  reason       String?
  details      Json?
  createdAt    DateTime   @default(now())

  @@index([automationId, createdAt])
  @@index([runId, createdAt])
  @@index([eventType, createdAt])
}

model AutomationRuntimeEvent {
  id        String   @id @default(cuid())
  eventType String
  status    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([createdAt])
}

model Setting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AnalyticsSnapshot {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  metrics     Json
  summary     String?
  createdAt   DateTime  @default(now())
}

model VideoIdea {
  id                 String               @id @default(cuid())
  projectId          String?
  project            Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  game               String?
  theme              String
  format             String
  premise            String
  estimatedEffort    Int?
  novelty            Float?
  identityFit        Float?
  opportunities      ContentOpportunity[]
  decisions          ContentDecision[]
  performanceSignals PerformanceSignal[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([projectId, createdAt])
}

model ContentOpportunity {
  id             String    @id @default(cuid())
  videoIdeaId    String
  videoIdea      VideoIdea @relation(fields: [videoIdeaId], references: [id], onDelete: Cascade)
  source         String
  classification String
  summary        String
  score          Float?
  createdAt      DateTime  @default(now())

  @@index([videoIdeaId, createdAt])
}

model ContentDecision {
  id         String    @id @default(cuid())
  videoIdeaId String
  videoIdea  VideoIdea @relation(fields: [videoIdeaId], references: [id], onDelete: Cascade)
  category   String
  score      Float
  rationale  String
  evidence   Json
  createdAt  DateTime  @default(now())

  @@index([videoIdeaId, createdAt])
}

model ChannelInsight {
  id             String   @id @default(cuid())
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  key            String   @unique
  category       String
  subject        String
  statement      String
  confidence     Float
  classification String
  evidence       Json?
  decisionOutcomes EditorialDecisionOutcome[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, category])
}

model PerformanceSignal {
  id             String     @id @default(cuid())
  projectId      String?
  project        Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  videoIdeaId    String?
  videoIdea      VideoIdea? @relation(fields: [videoIdeaId], references: [id], onDelete: SetNull)
  performanceSnapshotId String?
  performanceSnapshot VideoPerformanceSnapshot? @relation(fields: [performanceSnapshotId], references: [id], onDelete: Cascade)
  key            String?    @unique
  game           String?
  series         String?
  format         String?
  metric         String
  value          Float
  sampleSize     Int        @default(1)
  source         String
  classification String     @default("real")
  confidence     Float      @default(1)
  measuredAt     DateTime
  createdAt      DateTime   @default(now())

  @@index([projectId, game])
  @@index([projectId, format])
  @@index([projectId, series])
  @@index([videoIdeaId])
  @@index([performanceSnapshotId])
}

model VideoPerformanceSnapshot {
  id                         String              @id @default(cuid())
  projectId                  String?
  project                    Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ingestionKey               String              @unique
  videoId                    String
  title                      String
  game                       String?
  series                     String?
  format                     String?
  publishedAt                DateTime?
  periodStart                DateTime?
  periodEnd                  DateTime?
  views                      Float?
  engagedViews               Float?
  impressions                Float?
  ctr                        Float?
  durationSeconds            Float?
  averageViewDurationSeconds Float?
  averageViewPercentage      Float?
  watchTimeMinutes           Float?
  subscribersGained          Int?
  subscribersLost            Int?
  likes                      Int?
  comments                   Int?
  source                     String
  confidence                 Float              @default(1)
  collectedAt                DateTime
  performanceSignals         PerformanceSignal[]
  editorialOutcomes          EditorialDecision[]
  decisionVideoLinks         EditorialDecisionVideoLink[]
  decisionOutcomeSnapshots   EditorialDecisionOutcome[]
  outcomeReviewPreviousSnapshots EditorialDecisionOutcomeReview[] @relation("OutcomeReviewPreviousSnapshot")
  outcomeReviewCurrentSnapshots  EditorialDecisionOutcomeReview[] @relation("OutcomeReviewCurrentSnapshot")
  seriesLinks                    VideoSeriesLink[]
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([projectId, collectedAt])
  @@index([videoId, source])
  @@index([game])
  @@index([series])
  @@index([format])
}

model TrendSignal {
  id             String   @id @default(cuid())
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  key            String   @unique
  subject        String
  subjectType    String
  metric         String
  classification String
  currentWindow  Json
  previousWindow Json
  delta          Float?
  sampleSize     Int
  confidence     Float
  evidence       Json
  quality        Json
  detectedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, subjectType, detectedAt])
  @@index([classification, detectedAt])
}

model SeriesDefinition {
  id            String            @id @default(cuid())
  projectId     String?
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  key           String            @unique
  name          String
  normalizedKey String
  game          String?
  topic         String?
  status        String            @default("ACTIVE")
  metadata      Json?
  videoLinks    VideoSeriesLink[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([projectId, normalizedKey])
  @@index([status, updatedAt])
}

model VideoSeriesLink {
  id               String                   @id @default(cuid())
  seriesId         String
  series           SeriesDefinition         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  sourceSnapshotId String
  sourceSnapshot   VideoPerformanceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  videoId          String
  origin           String
  confidence       Float
  evidence         Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([seriesId, videoId])
  @@index([videoId])
  @@index([sourceSnapshotId])
}

model ContentPattern {
  id             String   @id @default(cuid())
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  key            String   @unique
  subject        String
  patternType    String
  classification String
  game           String?
  topic          String?
  format         String?
  series         String?
  summary        String
  sampleSize     Int
  confidence     Float
  evidence       Json
  quality        Json
  detectedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, patternType, detectedAt])
  @@index([classification, detectedAt])
}

model VideoReachSnapshot {
  id                    String   @id @default(cuid())
  projectId             String?
  project               Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ingestionKey          String   @unique
  videoId               String
  periodStart           DateTime
  periodEnd             DateTime
  impressions           Float
  ctr                    Float
  source                 String
  reportId               String?
  jobId                  String?
  reportCreatedAt        DateTime?
  collectedAt            DateTime
  freshnessAtCollection  String
  qualityAtCollection    String
  qualityReasons         Json
  providerMetadata       Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([projectId, collectedAt])
  @@index([videoId, periodStart, periodEnd, source])
  @@index([source, collectedAt])
}

model ReachSyncState {
  source        String   @id
  reportTypeId  String
  jobId         String?
  state         String
  lastReportAt  DateTime?
  lastSyncAt    DateTime?
  lastErrorType String?
  updatedAt     DateTime @updatedAt
}

model AudienceSnapshot {
  id                         String   @id @default(cuid())
  projectId                  String?
  project                    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ingestionKey               String   @unique
  dimension                  String
  segment                    String
  format                     String?
  periodStart                DateTime
  periodEnd                  DateTime
  views                      Float?
  engagedViews               Float?
  watchTimeMinutes           Float?
  averageViewDurationSeconds Float?
  averageViewPercentage      Float?
  source                     String
  collectedAt                DateTime
  freshnessAtCollection      String
  qualityAtCollection        String
  qualityReasons             Json
  providerMetadata           Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([projectId, dimension, periodStart, periodEnd])
  @@index([dimension, segment, format])
  @@index([source, collectedAt])
}

model AudienceSyncState {
  source        String   @id
  state         String
  lastSyncAt    DateTime?
  lastErrorType String?
  missingData   Json
  updatedAt     DateTime @updatedAt
}

model EditorialDecision {
  id                String                    @id @default(cuid())
  projectId         String?
  project           Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversationId    String?
  conversation      Conversation?             @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  operatorMessageId String?                   @unique
  operatorMessage   Message?                  @relation(fields: [operatorMessageId], references: [id], onDelete: SetNull)
  outcomeSnapshotId String?
  outcomeSnapshot   VideoPerformanceSnapshot? @relation(fields: [outcomeSnapshotId], references: [id], onDelete: SetNull)
  dedupeKey         String                    @unique
  question          String
  intent            String
  recommendation    String
  alternatives      Json
  score             Float?
  confidence        Float
  classification    String                    @default("recommendation")
  evidence          Json
  risks             Json
  missingData       Json
  nextAction        String
  outcome           Json?
  videoLinks        EditorialDecisionVideoLink[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@index([outcomeSnapshotId])
}

model EditorialDecisionVideoLink {
  id               String                   @id @default(cuid())
  decisionId       String
  decision         EditorialDecision        @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  sourceSnapshotId String
  sourceSnapshot   VideoPerformanceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  videoId          String
  origin           String                   @default("manual")
  notes            String?
  linkedAt         DateTime                 @default(now())
  outcomes         EditorialDecisionOutcome[]

  @@unique([decisionId, videoId])
  @@index([decisionId, linkedAt])
  @@index([videoId])
  @@index([sourceSnapshotId])
}

model EditorialDecisionOutcome {
  id                   String                    @id @default(cuid())
  decisionVideoLinkId  String
  decisionVideoLink    EditorialDecisionVideoLink @relation(fields: [decisionVideoLinkId], references: [id], onDelete: Cascade)
  snapshotId           String
  snapshot             VideoPerformanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  learningInsightId    String?
  learningInsight      ChannelInsight?           @relation(fields: [learningInsightId], references: [id], onDelete: SetNull)
  windowStart          DateTime?
  windowEnd            DateTime?
  baseline             Json
  facts                Json
  comparison           Json
  interpretation       Json
  confidence           Float
  classification       String
  supportingMetrics    Json
  contradictingMetrics Json
  missingData          Json
  hypotheses           Json
  sourceReviews        EditorialDecisionOutcomeReview[] @relation("OutcomeReviewSource")
  resultReviews        EditorialDecisionOutcomeReview[] @relation("OutcomeReviewResult")
  evaluatedAt          DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([decisionVideoLinkId, snapshotId])
  @@index([snapshotId])
  @@index([classification, evaluatedAt])
  @@index([learningInsightId])
}

model EditorialDecisionOutcomeReview {
  id                        String                     @id @default(cuid())
  sourceOutcomeId           String
  sourceOutcome             EditorialDecisionOutcome @relation("OutcomeReviewSource", fields: [sourceOutcomeId], references: [id], onDelete: Cascade)
  resultOutcomeId           String?
  resultOutcome             EditorialDecisionOutcome? @relation("OutcomeReviewResult", fields: [resultOutcomeId], references: [id], onDelete: SetNull)
  previousSnapshotId        String
  previousSnapshot          VideoPerformanceSnapshot  @relation("OutcomeReviewPreviousSnapshot", fields: [previousSnapshotId], references: [id], onDelete: Restrict)
  currentSnapshotId         String
  currentSnapshot           VideoPerformanceSnapshot  @relation("OutcomeReviewCurrentSnapshot", fields: [currentSnapshotId], references: [id], onDelete: Restrict)
  reviewKey                 String                     @unique
  status                    String                     @default("pending")
  reason                    String
  previousClassification    String
  currentClassification     String?
  previousConfidence        Float
  currentConfidence         Float?
  changedMetrics            Json
  previousState             Json
  currentState              Json?
  errorType                 String?
  startedAt                 DateTime                   @default(now())
  completedAt               DateTime?

  @@index([sourceOutcomeId, startedAt])
  @@index([status, startedAt])
  @@index([currentSnapshotId])
}

model OrchestrationExecution {
  id                String    @id @default(cuid())
  projectId         String?
  project           Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversationId    String?
  idempotencyKey    String?   @unique
  intent            String
  objective         String
  status            String    @default("pending")
  capabilities      Json
  request           Json
  plan              Json
  result             Json?
  evidence          Json?
  failures          Json
  errorType         String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  review             PlanReview?
  auditEvents        OrchestrationAuditEvent[]

  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model PlanReview {
  id                String   @id @default(cuid())
  executionId       String   @unique
  execution         OrchestrationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  state             String
  reviewer          String?
  reviewedAt        DateTime?
  decision          String?
  reason            String?
  riskLevel         String
  sideEffectLevel   String
  requiredApprovals Int      @default(0)
  version           Int      @default(1)
  planHash          String
  approvedPlanHash  String?
  approvedPlan      Json?
  validUntil        DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([state, createdAt])
  @@index([riskLevel, createdAt])
}

model OrchestrationAuditEvent {
  id          String   @id @default(cuid())
  executionId String
  execution   OrchestrationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  eventType   String
  actor       String?
  reason      String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([executionId, createdAt])
  @@index([eventType, createdAt])
}
