generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      String?    @default("user")
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id               String             @id @default(cuid())
  name             String
  description      String?
  ownerId          String
  owner            User               @relation(fields: [ownerId], references: [id])
  conversations    Conversation[]
  libraryItems     LibraryItem[]
  automations      Automation[]
  analyticsSnapshots AnalyticsSnapshot[]
  videoIdeas         VideoIdea[]
  channelInsights    ChannelInsight[]
  performanceSignals PerformanceSignal[]
  videoPerformanceSnapshots VideoPerformanceSnapshot[]
  videoReachSnapshots VideoReachSnapshot[]
  audienceSnapshots   AudienceSnapshot[]
  trendSignals        TrendSignal[]
  seriesDefinitions   SeriesDefinition[]
  contentPatterns     ContentPattern[]
  editorialDecisions EditorialDecision[]
  orchestrationExecutions OrchestrationExecution[]
  researchHistories ResearchHistory[]
  contentPlans     ContentPlan[]
  planningOutcomeLinks PlanningOutcomeLink[]
  planningOutcomes PlanningOutcome[]
  strategicLearnings StrategicLearning[]
  strategicExperiments StrategicExperiment[]
  strategicSignals StrategicSignal[]
  monitoringSnapshots MonitoringSnapshot[]
  channelContextEntries ChannelContextEntry[]
  contentPackagings ContentPackaging[]
  contentProductions ContentProduction[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Conversation {
  id               String                    @id @default(cuid())
  projectId        String?
  project          Project?                  @relation(fields: [projectId], references: [id])
  title            String?
  context          String?
  messages         Message[]
  libraryItemLinks ConversationLibraryItem[]
  editorialDecisions EditorialDecision[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         String
  text           String
  libraryItem    LibraryItem?
  editorialDecision EditorialDecision?
  createdAt      DateTime  @default(now())
}

model Operator {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String?   @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ChannelSnapshot {
  id              String   @id @default(cuid())
  channelId       String   @unique
  title           String
  subscriberCount String?
  videoCount      String?
  viewCount       String?
  country         String?
  publishedAt     DateTime?
  collectedAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([collectedAt])
}

model LibraryItem {
  id                String                    @id @default(cuid())
  projectId         String?
  project           Project?                  @relation(fields: [projectId], references: [id])
  sourceMessageId   String?                   @unique
  sourceMessage     Message?                  @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  conversationLinks ConversationLibraryItem[]
  productionAssets ProductionAssetRelation[]
  transcripts      TimedTranscript[]
  title             String
  type              String?
  content           String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model ConversationLibraryItem {
  conversationId String
  libraryItemId  String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  libraryItem    LibraryItem  @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([conversationId, libraryItemId])
  @@index([conversationId, createdAt, libraryItemId])
  @@index([libraryItemId])
}

model Automation {
  id                 String                 @id @default(cuid())
  projectId          String?
  project            Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name               String
  description        String?
  trigger            String?
  action             String?
  triggerType        String                 @default("MANUAL_ONLY")
  schedule           Json?
  timezone           String                 @default("UTC")
  intent             String?
  orchestrationInput Json?
  status             String                 @default("DISABLED")
  riskLevel          String?
  sideEffectLevel    String?
  enabled            Boolean                @default(false)
  nextRunAt          DateTime?
  lastRunAt          DateTime?
  runs               AutomationRun[]
  auditEvents        AutomationAuditEvent[]
  governancePolicy   AutomationGovernancePolicy?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([enabled, status, nextRunAt])
  @@index([projectId, createdAt])
}

model AutomationRun {
  id                       String     @id @default(cuid())
  automationId             String
  automation               Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  occurrenceKey            String
  triggerSource            String
  status                   String     @default("PENDING")
  scheduledFor             DateTime?
  orchestrationExecutionId String?
  resultSummary            String?
  failureReason            String?
  attempt                  Int        @default(1)
  sourceRunId              String?
  startedAt                DateTime?
  completedAt              DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@unique([automationId, occurrenceKey])
  @@index([automationId, createdAt])
  @@index([status, createdAt])
  @@index([orchestrationExecutionId])
  @@index([sourceRunId])
}

model AutomationGovernancePolicy {
  automationId              String     @id
  automation                Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  enabled                   Boolean    @default(true)
  maxRunsPerDay             Int?
  maxRunsPerWeek            Int?
  cooldownMinutes           Int?
  allowedExecutionWindows   Json?
  maxConsecutiveFailures    Int?
  pauseOnRepeatedFailure    Boolean    @default(true)
  manualApprovalRequired    Boolean    @default(false)
  retryPolicy               Json?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  @@index([enabled, updatedAt])
}

model AutomationAuditEvent {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runId        String?
  eventType    String
  reason       String?
  details      Json?
  createdAt    DateTime   @default(now())

  @@index([automationId, createdAt])
  @@index([runId, createdAt])
  @@index([eventType, createdAt])
}

model AutomationRuntimeEvent {
  id        String   @id @default(cuid())
  eventType String
  status    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([createdAt])
}

model Setting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AnalyticsSnapshot {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  metrics     Json
  summary     String?
  createdAt   DateTime  @default(now())
}

model VideoIdea {
  id                 String               @id @default(cuid())
  projectId          String?
  project            Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  game               String?
  theme              String
  format             String
  premise            String
  estimatedEffort    Int?
  novelty            Float?
  identityFit        Float?
  workingTitle       String?
  series             String?
  coreEvent          String?
  viewerPromise      String?
  whyNow             String?
  status             String               @default("CANDIDATE")
  effortLevel        String               @default("UNKNOWN")
  risks              Json                 @default("[]")
  assumptions        Json                 @default("[]")
  hypothesis         String?
  strategicFit       Float?
  opportunityScore   Float?
  scoreDetails       Json?
  sourceResearchHistoryId String?
  sourceResearchHistory ResearchHistory?  @relation(fields: [sourceResearchHistoryId], references: [id], onDelete: SetNull)
  sourceOpportunityId String?
  sourceOpportunity  ResearchOpportunity? @relation(fields: [sourceOpportunityId], references: [id], onDelete: SetNull)
  ideaKey            String?              @unique
  duplicateOfId      String?
  duplicateOf        VideoIdea?           @relation("VideoIdeaDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates         VideoIdea[]          @relation("VideoIdeaDuplicate")
  isExperiment       Boolean              @default(false)
  selectedAt         DateTime?
  rejectedAt         DateTime?
  archivedAt         DateTime?
  rejectionReason    String?
  opportunities      ContentOpportunity[]
  decisions          ContentDecision[]
  performanceSignals PerformanceSignal[]
  productions        ContentProduction[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, status, updatedAt])
  @@index([sourceResearchHistoryId])
  @@index([sourceOpportunityId])
}

model ContentOpportunity {
  id             String    @id @default(cuid())
  videoIdeaId    String
  videoIdea      VideoIdea @relation(fields: [videoIdeaId], references: [id], onDelete: Cascade)
  source         String
  classification String
  summary        String
  score          Float?
  createdAt      DateTime  @default(now())

  @@index([videoIdeaId, createdAt])
}

model ContentDecision {
  id         String    @id @default(cuid())
  videoIdeaId String
  videoIdea  VideoIdea @relation(fields: [videoIdeaId], references: [id], onDelete: Cascade)
  category   String
  score      Float
  rationale  String
  evidence   Json
  createdAt  DateTime  @default(now())

  @@index([videoIdeaId, createdAt])
}

model ChannelInsight {
  id             String   @id @default(cuid())
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  key            String   @unique
  category       String
  subject        String
  statement      String
  confidence     Float
  classification String
  evidence       Json?
  decisionOutcomes EditorialDecisionOutcome[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, category])
}

model ChannelContextEntry {
  id             String                   @id @default(cuid())
  projectId      String?
  project        Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  stableKey      String                   @unique
  channelId      String?
  type           String
  status         String                   @default("ACTIVE")
  category       String
  subject        String
  statement      String
  confidence     Float                    @default(1)
  source         String
  sourceReference String?
  occurredAt     DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  entityType     String?
  entityId       String?
  game           String?
  series         String?
  format         String?
  metadata       Json?
  supersedesId   String?                  @unique
  supersedes     ChannelContextEntry?     @relation("ChannelContextSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   ChannelContextEntry?     @relation("ChannelContextSupersession")
  relations      ChannelContextRelation[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([projectId, type, status])
  @@index([channelId, occurredAt])
  @@index([category, subject])
  @@index([entityType, entityId])
  @@index([game, series, format])
}

model ChannelContextRelation {
  id          String              @id @default(cuid())
  contextId   String
  context     ChannelContextEntry @relation(fields: [contextId], references: [id], onDelete: Cascade)
  relation    String
  entityType  String
  entityId    String
  createdAt   DateTime            @default(now())

  @@unique([contextId, relation, entityType, entityId])
  @@index([entityType, entityId])
  @@index([contextId, createdAt])
}

model PerformanceSignal {
  id             String     @id @default(cuid())
  projectId      String?
  project        Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  videoIdeaId    String?
  videoIdea      VideoIdea? @relation(fields: [videoIdeaId], references: [id], onDelete: SetNull)
  performanceSnapshotId String?
  performanceSnapshot VideoPerformanceSnapshot? @relation(fields: [performanceSnapshotId], references: [id], onDelete: Cascade)
  key            String?    @unique
  game           String?
  series         String?
  format         String?
  metric         String
  value          Float
  sampleSize     Int        @default(1)
  source         String
  classification String     @default("real")
  confidence     Float      @default(1)
  measuredAt     DateTime
  createdAt      DateTime   @default(now())

  @@index([projectId, game])
  @@index([projectId, format])
  @@index([projectId, series])
  @@index([videoIdeaId])
  @@index([performanceSnapshotId])
}

model VideoPerformanceSnapshot {
  id                         String              @id @default(cuid())
  projectId                  String?
  project                    Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ingestionKey               String              @unique
  videoId                    String
  title                      String
  game                       String?
  series                     String?
  format                     String?
  publishedAt                DateTime?
  periodStart                DateTime?
  periodEnd                  DateTime?
  views                      Float?
  engagedViews               Float?
  impressions                Float?
  ctr                        Float?
  durationSeconds            Float?
  averageViewDurationSeconds Float?
  averageViewPercentage      Float?
  watchTimeMinutes           Float?
  subscribersGained          Int?
  subscribersLost            Int?
  likes                      Int?
  comments                   Int?
  source                     String
  confidence                 Float              @default(1)
  collectedAt                DateTime
  performanceSignals         PerformanceSignal[]
  editorialOutcomes          EditorialDecision[]
  decisionVideoLinks         EditorialDecisionVideoLink[]
  decisionOutcomeSnapshots   EditorialDecisionOutcome[]
  outcomeReviewPreviousSnapshots EditorialDecisionOutcomeReview[] @relation("OutcomeReviewPreviousSnapshot")
  outcomeReviewCurrentSnapshots  EditorialDecisionOutcomeReview[] @relation("OutcomeReviewCurrentSnapshot")
  planningOutcomeLinks           PlanningOutcomeLink[]             @relation("PlanningOutcomeLinkSource")
  planningOutcomes               PlanningOutcome[]                 @relation("PlanningOutcomeSnapshot")
  seriesLinks                    VideoSeriesLink[]
  packagingMetricSnapshots      PackagingMetricSnapshot[]
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([projectId, collectedAt])
  @@index([videoId, source])
  @@index([game])
  @@index([series])
  @@index([format])
}

model ContentPackaging {
  id                 String                @id @default(cuid())
  projectId          String?
  project            Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contentKey         String                @unique
  videoId            String?
  game               String?
  series             String?
  episode            Int?
  format             String?
  summary            String
  keyEvents          Json                  @default("[]")
  editorialObjective String?
  constraints        Json                  @default("[]")
  status             String                @default("DRAFT")
  contextSnapshot    Json                  @default("[]")
  variants           PackagingVariant[]
  history            PackagingHistory[]
  experiments        PackagingExperiment[]
  productions        ContentProduction[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([projectId, updatedAt])
  @@index([videoId])
  @@index([game, series, format])
}

model PackagingVariant {
  id                    String                    @id @default(cuid())
  packagingId           String
  packaging             ContentPackaging          @relation(fields: [packagingId], references: [id], onDelete: Cascade)
  key                   String
  title                 String
  angle                 String
  sourceEvent           String
  thumbnailBrief        Json
  description           String
  tags                  Json                      @default("[]")
  rationale             String
  seriesFit             Float                     @default(0)
  clickbaitRisk         String                    @default("LOW")
  internalScore         Float
  contextUsed           Json                      @default("[]")
  status                String                    @default("DRAFT")
  manualEdits           Json                      @default("{}")
  selectedAt            DateTime?
  publishedAt           DateTime?
  publishedVideoId      String?
  metricSnapshots       PackagingMetricSnapshot[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([packagingId, key])
  @@index([packagingId, status])
  @@index([publishedVideoId])
}

model PackagingHistory {
  id          String           @id @default(cuid())
  packagingId String
  packaging   ContentPackaging @relation(fields: [packagingId], references: [id], onDelete: Cascade)
  variantId   String?
  event       String
  reason      String?
  data        Json             @default("{}")
  createdAt   DateTime         @default(now())

  @@index([packagingId, createdAt])
  @@index([variantId, createdAt])
}

model PackagingMetricSnapshot {
  id                    String                    @id @default(cuid())
  variantId             String
  variant               PackagingVariant          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  performanceSnapshotId String?
  performanceSnapshot   VideoPerformanceSnapshot? @relation(fields: [performanceSnapshotId], references: [id], onDelete: SetNull)
  ingestionKey          String                    @unique
  videoId               String
  periodStart           DateTime?
  periodEnd             DateTime?
  metrics               Json
  source                String
  confidence            Float                     @default(1)
  createdAt             DateTime                  @default(now())

  @@index([variantId, createdAt])
  @@index([videoId, periodEnd])
  @@index([performanceSnapshotId])
}

model PackagingExperiment {
  id             String           @id @default(cuid())
  packagingId    String
  packaging      ContentPackaging @relation(fields: [packagingId], references: [id], onDelete: Cascade)
  hypothesis     String
  variantIds     Json             @default("[]")
  status         String           @default("ACTIVE")
  contextEntryId String?
  outcome        String?
  confidence     Float            @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([packagingId, status])
  @@index([contextEntryId])
}

model TrendSignal {
  id             String   @id @default(cuid())
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  key            String   @unique
  subject        String
  subjectType    String
  metric         String
  classification String
  currentWindow  Json
  previousWindow Json
  delta          Float?
  sampleSize     Int
  confidence     Float
  evidence       Json
  quality        Json
  detectedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, subjectType, detectedAt])
  @@index([classification, detectedAt])
}

model SeriesDefinition {
  id            String            @id @default(cuid())
  projectId     String?
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  key           String            @unique
  name          String
  normalizedKey String
  game          String?
  topic         String?
  status        String            @default("ACTIVE")
  metadata      Json?
  videoLinks    VideoSeriesLink[]
  plannedItems  PlannedContentItem[]
  productions   ContentProduction[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([projectId, normalizedKey])
  @@index([status, updatedAt])
}

model VideoSeriesLink {
  id               String                   @id @default(cuid())
  seriesId         String
  series           SeriesDefinition         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  sourceSnapshotId String
  sourceSnapshot   VideoPerformanceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  videoId          String
  origin           String
  confidence       Float
  evidence         Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([seriesId, videoId])
  @@index([videoId])
  @@index([sourceSnapshotId])
}

model ContentPattern {
  id             String   @id @default(cuid())
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  key            String   @unique
  subject        String
  patternType    String
  classification String
  game           String?
  topic          String?
  format         String?
  series         String?
  summary        String
  sampleSize     Int
  confidence     Float
  evidence       Json
  quality        Json
  detectedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, patternType, detectedAt])
  @@index([classification, detectedAt])
}

model ResearchHistory {
  id              String                @id @default(cuid())
  projectId       String?
  project         Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  executionKey    String                @unique
  cacheKey        String
  query           String
  normalizedQuery String
  intent          String
  subjectType     String?
  subject         String?
  sources         Json
  results         Json
  quality         String
  freshness       String
  limitations     Json
  context         Json?
  status          String                @default("COMPLETED")
  objective       String?
  format          String?
  game            String?
  constraints     Json                  @default("[]")
  runVersion      Int                   @default(1)
  startedAt       DateTime?
  completedAt     DateTime?
  archivedAt      DateTime?
  researchedAt    DateTime
  validUntil      DateTime
  opportunities   ResearchOpportunity[]
  evidenceItems   ResearchEvidenceItem[]
  events          ResearchSessionEvent[]
  contentGaps     ResearchContentGap[]
  ideas           VideoIdea[]
  requestedPlanningItems PlannedContentItem[] @relation("PlanningItemResearchExecution")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([projectId, researchedAt])
  @@index([cacheKey, researchedAt])
  @@index([quality, freshness])
  @@index([status, updatedAt])
}

model ResearchOpportunity {
  id                String          @id @default(cuid())
  researchHistoryId String
  researchHistory   ResearchHistory @relation(fields: [researchHistoryId], references: [id], onDelete: Cascade)
  key               String
  rank              Int
  subject           String
  subjectType       String
  state             String
  summary           String
  sources           Json
  evidence          Json
  freshness         String
  compatibility     Float
  confidence        Float
  risks             Json
  gaps              Json
  nextInvestigation String
  candidateStatus   String          @default("CANDIDATE")
  effort            String          @default("UNKNOWN")
  novelty           Float?
  saturation        Float?
  qualityGate       String          @default("INSUFFICIENT_EVIDENCE")
  scoreDetails      Json?
  plannedItems      PlannedContentItem[]
  ideas             VideoIdea[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([researchHistoryId, key])
  @@index([researchHistoryId, rank])
  @@index([state, confidence, createdAt])
  @@index([subjectType, subject])
}

model ResearchEvidenceItem {
  id                String          @id @default(cuid())
  researchHistoryId String
  researchHistory   ResearchHistory @relation(fields: [researchHistoryId], references: [id], onDelete: Cascade)
  evidenceKey       String
  sourceType        String
  sourceId          String?
  sourceName        String
  classification    String
  description       String
  metricName        String?
  metricValue       Float?
  unit              String?
  reference         String?
  observedAt        DateTime?
  retrievedAt       DateTime
  freshness         String
  confidence        Float?
  provenance        Json?
  context           Json?
  createdAt         DateTime        @default(now())

  @@unique([researchHistoryId, evidenceKey])
  @@index([researchHistoryId, sourceType])
  @@index([sourceType, sourceId])
}

model ResearchSessionEvent {
  id                String          @id @default(cuid())
  researchHistoryId String
  researchHistory   ResearchHistory @relation(fields: [researchHistoryId], references: [id], onDelete: Cascade)
  event             String
  reason            String?
  data              Json?
  occurredAt        DateTime
  createdAt         DateTime        @default(now())

  @@index([researchHistoryId, occurredAt])
  @@index([event, occurredAt])
}

model ResearchContentGap {
  id                String          @id @default(cuid())
  researchHistoryId String
  researchHistory   ResearchHistory @relation(fields: [researchHistoryId], references: [id], onDelete: Cascade)
  gapKey            String
  description       String
  relevance         Float
  risk              String?
  freshness         String
  game              String?
  series            String?
  possibleAction    String
  evidence          Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([researchHistoryId, gapKey])
  @@index([researchHistoryId, relevance])
}

model ContentPlan {
  id          String               @id @default(cuid())
  projectId   String?
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  horizon     String
  status      String
  summary     String
  balance     Json
  constraints Json
  risks       Json
  source      Json
  generatedAt DateTime
  items       PlannedContentItem[]
  history     PlanningHistory[]
  executionHistory PlanningExecutionEvent[]
  outcomeLinks PlanningOutcomeLink[]
  outcomes PlanningOutcome[]
  outcomeAuditEvents PlanningOutcomeAuditEvent[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([projectId, generatedAt])
  @@index([status, horizon, generatedAt])
}

model PlannedContentItem {
  id                          String               @id @default(cuid())
  planId                      String
  plan                        ContentPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  sourceDecisionId            String?
  sourceDecision              EditorialDecision?  @relation(fields: [sourceDecisionId], references: [id], onDelete: SetNull)
  sourceResearchOpportunityId String?
  sourceResearchOpportunity   ResearchOpportunity? @relation(fields: [sourceResearchOpportunityId], references: [id], onDelete: SetNull)
  researchHistoryId           String?
  researchHistory             ResearchHistory?    @relation("PlanningItemResearchExecution", fields: [researchHistoryId], references: [id], onDelete: SetNull)
  seriesId                    String?
  series                      SeriesDefinition?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  candidateKey                String
  candidateType               String
  title                       String
  rationale                   String
  status                      String
  priority                    String
  effort                      String
