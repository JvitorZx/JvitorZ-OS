  source                     String
  collectedAt                DateTime
  freshnessAtCollection      String
  qualityAtCollection        String
  qualityReasons             Json
  providerMetadata           Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([projectId, dimension, periodStart, periodEnd])
  @@index([dimension, segment, format])
  @@index([source, collectedAt])
}

model AudienceSyncState {
  source        String   @id
  state         String
  lastSyncAt    DateTime?
  lastErrorType String?
  missingData   Json
  updatedAt     DateTime @updatedAt
}

model EditorialDecision {
  id                String                    @id @default(cuid())
  projectId         String?
  project           Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversationId    String?
  conversation      Conversation?             @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  operatorMessageId String?                   @unique
  operatorMessage   Message?                  @relation(fields: [operatorMessageId], references: [id], onDelete: SetNull)
  outcomeSnapshotId String?
  outcomeSnapshot   VideoPerformanceSnapshot? @relation(fields: [outcomeSnapshotId], references: [id], onDelete: SetNull)
  dedupeKey         String                    @unique
  question          String
  intent            String
  recommendation    String
  alternatives      Json
  score             Float?
  confidence        Float
  classification    String                    @default("recommendation")
  category          String                    @default("INSUFFICIENT_DATA")
  candidateType     String?
  candidateKey      String?
  opportunityScore  Json?
  favorableEvidence Json                      @default("[]")
  contraryEvidence  Json                      @default("[]")
  constraints       Json                      @default("[]")
  evidence          Json
  risks             Json
  missingData       Json
  nextAction        String
  outcome           Json?
  videoLinks        EditorialDecisionVideoLink[]
  plannedItems      PlannedContentItem[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@index([category, createdAt])
  @@index([candidateType, candidateKey])
  @@index([outcomeSnapshotId])
}

model EditorialDecisionVideoLink {
  id               String                   @id @default(cuid())
  decisionId       String
  decision         EditorialDecision        @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  sourceSnapshotId String
  sourceSnapshot   VideoPerformanceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  videoId          String
  origin           String                   @default("manual")
  notes            String?
  linkedAt         DateTime                 @default(now())
  outcomes         EditorialDecisionOutcome[]

  @@unique([decisionId, videoId])
  @@index([decisionId, linkedAt])
  @@index([videoId])
  @@index([sourceSnapshotId])
}

model EditorialDecisionOutcome {
  id                   String                    @id @default(cuid())
  decisionVideoLinkId  String
  decisionVideoLink    EditorialDecisionVideoLink @relation(fields: [decisionVideoLinkId], references: [id], onDelete: Cascade)
  snapshotId           String
  snapshot             VideoPerformanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  learningInsightId    String?
  learningInsight      ChannelInsight?           @relation(fields: [learningInsightId], references: [id], onDelete: SetNull)
  windowStart          DateTime?
  windowEnd            DateTime?
  baseline             Json
  facts                Json
  comparison           Json
  interpretation       Json
  confidence           Float
  classification       String
  supportingMetrics    Json
  contradictingMetrics Json
  missingData          Json
  hypotheses           Json
  sourceReviews        EditorialDecisionOutcomeReview[] @relation("OutcomeReviewSource")
  resultReviews        EditorialDecisionOutcomeReview[] @relation("OutcomeReviewResult")
  evaluatedAt          DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([decisionVideoLinkId, snapshotId])
  @@index([snapshotId])
  @@index([classification, evaluatedAt])
  @@index([learningInsightId])
}

model EditorialDecisionOutcomeReview {
  id                        String                     @id @default(cuid())
  sourceOutcomeId           String
  sourceOutcome             EditorialDecisionOutcome @relation("OutcomeReviewSource", fields: [sourceOutcomeId], references: [id], onDelete: Cascade)
  resultOutcomeId           String?
  resultOutcome             EditorialDecisionOutcome? @relation("OutcomeReviewResult", fields: [resultOutcomeId], references: [id], onDelete: SetNull)
  previousSnapshotId        String
  previousSnapshot          VideoPerformanceSnapshot  @relation("OutcomeReviewPreviousSnapshot", fields: [previousSnapshotId], references: [id], onDelete: Restrict)
  currentSnapshotId         String
  currentSnapshot           VideoPerformanceSnapshot  @relation("OutcomeReviewCurrentSnapshot", fields: [currentSnapshotId], references: [id], onDelete: Restrict)
  reviewKey                 String                     @unique
  status                    String                     @default("pending")
  reason                    String
  previousClassification    String
  currentClassification     String?
  previousConfidence        Float
  currentConfidence         Float?
  changedMetrics            Json
  previousState             Json
  currentState              Json?
  errorType                 String?
  startedAt                 DateTime                   @default(now())
  completedAt               DateTime?

  @@index([sourceOutcomeId, startedAt])
  @@index([status, startedAt])
  @@index([currentSnapshotId])
}

model OrchestrationExecution {
  id                String    @id @default(cuid())
  projectId         String?
  project           Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversationId    String?
  idempotencyKey    String?   @unique
  intent            String
  objective         String
  status            String    @default("pending")
  capabilities      Json
  request           Json
  plan              Json
  result             Json?
  evidence          Json?
  failures          Json
  errorType         String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  review             PlanReview?
  auditEvents        OrchestrationAuditEvent[]

  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model PlanReview {
  id                String   @id @default(cuid())
  executionId       String   @unique
  execution         OrchestrationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  state             String
  reviewer          String?
  reviewedAt        DateTime?
  decision          String?
  reason            String?
  riskLevel         String
  sideEffectLevel   String
  requiredApprovals Int      @default(0)
  version           Int      @default(1)
  planHash          String
  approvedPlanHash  String?
  approvedPlan      Json?
  validUntil        DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([state, createdAt])
  @@index([riskLevel, createdAt])
}

model OrchestrationAuditEvent {
  id          String   @id @default(cuid())
  executionId String
  execution   OrchestrationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  eventType   String
  actor       String?
  reason      String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([executionId, createdAt])
  @@index([eventType, createdAt])
}
