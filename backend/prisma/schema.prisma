generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      String?    @default("user")
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id               String             @id @default(cuid())
  name             String
  description      String?
  ownerId          String
  owner            User               @relation(fields: [ownerId], references: [id])
  conversations    Conversation[]
  libraryItems     LibraryItem[]
  automations      Automation[]
  analyticsSnapshots AnalyticsSnapshot[]
  videoIdeas         VideoIdea[]
  channelInsights    ChannelInsight[]
  performanceSignals PerformanceSignal[]
  videoPerformanceSnapshots VideoPerformanceSnapshot[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Conversation {
  id               String                    @id @default(cuid())
  projectId        String?
  project          Project?                  @relation(fields: [projectId], references: [id])
  title            String?
  context          String?
  messages         Message[]
  libraryItemLinks ConversationLibraryItem[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         String
  text           String
  libraryItem    LibraryItem?
  createdAt      DateTime  @default(now())
}

model Operator {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String?   @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model LibraryItem {
  id                String                    @id @default(cuid())
  projectId         String?
  project           Project?                  @relation(fields: [projectId], references: [id])
  sourceMessageId   String?                   @unique
  sourceMessage     Message?                  @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  conversationLinks ConversationLibraryItem[]
  title             String
  type              String?
  content           String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model ConversationLibraryItem {
  conversationId String
  libraryItemId  String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  libraryItem    LibraryItem  @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([conversationId, libraryItemId])
  @@index([conversationId, createdAt, libraryItemId])
  @@index([libraryItemId])
}

model Automation {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  name        String
  description String?
  trigger     String?
  action      String?
  enabled     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Setting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AnalyticsSnapshot {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  metrics     Json
  summary     String?
  createdAt   DateTime  @default(now())
}

model VideoIdea {
  id                 String               @id @default(cuid())
  projectId          String?
  project            Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  game               String?
  theme              String
  format             String
  premise            String
  estimatedEffort    Int?
  novelty            Float?
  identityFit        Float?
  opportunities      ContentOpportunity[]
  decisions          ContentDecision[]
  performanceSignals PerformanceSignal[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([projectId, createdAt])
}

model ContentOpportunity {
  id             String    @id @default(cuid())
  videoIdeaId    String
  videoIdea      VideoIdea @relation(fields: [videoIdeaId], references: [id], onDelete: Cascade)
  source         String
  classification String
  summary        String
  score          Float?
  createdAt      DateTime  @default(now())

  @@index([videoIdeaId, createdAt])
}

model ContentDecision {
  id         String    @id @default(cuid())
  videoIdeaId String
  videoIdea  VideoIdea @relation(fields: [videoIdeaId], references: [id], onDelete: Cascade)
  category   String
  score      Float
  rationale  String
  evidence   Json
  createdAt  DateTime  @default(now())

  @@index([videoIdeaId, createdAt])
}

model ChannelInsight {
  id             String   @id @default(cuid())
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  key            String   @unique
  category       String
  subject        String
  statement      String
  confidence     Float
  classification String
  evidence       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, category])
}

model PerformanceSignal {
  id             String     @id @default(cuid())
  projectId      String?
  project        Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  videoIdeaId    String?
  videoIdea      VideoIdea? @relation(fields: [videoIdeaId], references: [id], onDelete: SetNull)
  performanceSnapshotId String?
  performanceSnapshot VideoPerformanceSnapshot? @relation(fields: [performanceSnapshotId], references: [id], onDelete: Cascade)
  key            String?    @unique
  game           String?
  series         String?
  format         String?
  metric         String
  value          Float
  sampleSize     Int        @default(1)
  source         String
  classification String     @default("real")
  confidence     Float      @default(1)
  measuredAt     DateTime
  createdAt      DateTime   @default(now())

  @@index([projectId, game])
  @@index([projectId, format])
  @@index([projectId, series])
  @@index([videoIdeaId])
  @@index([performanceSnapshotId])
}

model VideoPerformanceSnapshot {
  id                         String              @id @default(cuid())
  projectId                  String?
  project                    Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ingestionKey               String              @unique
  videoId                    String
  title                      String
  game                       String?
  series                     String?
  format                     String?
  publishedAt                DateTime?
  periodStart                DateTime?
  periodEnd                  DateTime?
  views                      Float?
  impressions                Float?
  ctr                        Float?
  durationSeconds            Float?
  averageViewDurationSeconds Float?
  averageViewPercentage      Float?
  watchTimeMinutes           Float?
  subscribersGained          Int?
  likes                      Int?
  comments                   Int?
  source                     String
  confidence                 Float              @default(1)
  collectedAt                DateTime
  performanceSignals         PerformanceSignal[]
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([projectId, collectedAt])
  @@index([videoId, source])
  @@index([game])
  @@index([series])
  @@index([format])
}
